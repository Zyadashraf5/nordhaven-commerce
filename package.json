{
  "name": "nordhaven-commerce",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@12.13.0",
  "engines": {
    "node": ">=22.23.3 <23",
    "pnpm": "12.13.0"
  },
  "scripts": {
    "build": "pnpm --filter @nordhaven/api build",
    "dev": "pnpm --filter @nordhaven/api dev",
    "start": "pnpm --filter @nordhaven/api start",
    "front:dev": "pnpm --filter @nordhaven/front dev",
    "front:build": "pnpm --filter @nordhaven/front build",
    "front:start": "pnpm --filter @nordhaven/front start",
    "front:lint": "pnpm --filter @nordhaven/front lint",
    "front:typecheck": "pnpm --filter @nordhaven/front typecheck",
    "front:test": "pnpm --filter @nordhaven/front test",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "eslint . --max-warnings 0",
    "boundaries:check": "node scripts/check-boundaries.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit && pnpm --filter @nordhaven/api typecheck",
    "test:unit": "node --experimental-vm-modules node_modules/jest/bin/jest.js --selectProjects unit --runInBand",
    "test:integration": "node --experimental-vm-modules node_modules/jest/bin/jest.js --selectProjects integration --runInBand",
    "test:e2e": "node --experimental-vm-modules node_modules/jest/bin/jest.js --selectProjects e2e --runInBand",
    "test:process": "node --experimental-vm-modules node_modules/jest/bin/jest.js --selectProjects process --runInBand",
    "db:up": "docker compose up -d postgres",
    "db:wait": "node scripts/db-wait.mjs",
    "db:down": "docker compose stop postgres",
    "prisma:generate": "prisma generate",
    "prisma:validate": "prisma validate",
    "prisma:migrate:create": "node scripts/prisma-migrate-create.mjs",
    "prisma:migrate:dev": "prisma migrate dev",
    "prisma:migrate:deploy": "prisma migrate deploy",
    "prisma:migrate:status": "prisma migrate status",
    "openapi:generate": "pnpm build && node scripts/openapi-generate.mjs openapi/openapi.json",
    "openapi:check": "pnpm build && node scripts/openapi-check.mjs",
    "repo:hygiene": "node scripts/check-repository-hygiene.mjs",
    "verify": "node scripts/verify.mjs",
    "audit:prod": "pnpm audit --prod",
    "readiness:check": "node scripts/production-readiness-check.mjs",
    "readiness:backup-drill": "node scripts/backup-restore-drill.mjs",
    "readiness:performance": "node scripts/performance-probe.mjs",
    "readiness:image-smoke": "node scripts/runtime-image-smoke.mjs"
  },
  "devDependencies": {
    "@apidevtools/swagger-parser": "10.1.1",
    "@eslint/js": "9.39.1",
    "@types/jest": "29.5.14",
    "@types/node": "22.19.1",
    "@types/pg": "8.15.6",
    "@types/supertest": "6.0.3",
    "dotenv": "17.2.3",
    "eslint": "9.39.1",
    "eslint-config-prettier": "10.1.8",
    "globals": "16.5.0",
    "jest": "29.7.0",
    "openapi-response-validator": "12.1.3",
    "pg": "8.16.3",
    "prettier": "3.7.4",
    "prisma": "7.10.0",
    "supertest": "7.2.2",
    "ts-jest": "29.4.6",
    "ts-node": "10.9.2",
    "typescript": "5.9.3",
    "typescript-eslint": "8.51.0"
  }
}
