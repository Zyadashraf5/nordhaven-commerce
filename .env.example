NODE_ENV=development
PORT=3000
DATABASE_URL=postgresql://nordhaven:local_only_change_me@localhost:5432/hc_batch_final_20261021_dev?schema=public
LOG_LEVEL=info
DATABASE_STARTUP_TIMEOUT_MS=5000
DATABASE_PROBE_TIMEOUT_MS=1000
SHUTDOWN_TIMEOUT_MS=8000

# Identity and Access (Milestone 02)
# AUTH_ENCRYPTION_KEY is the only newly required value. It protects administrator MFA secrets at
# rest and must be base64 for exactly 32 random bytes. Generate one locally and never commit or
# share the real value:
#   node -e "console.log(require('node:crypto').randomBytes(32).toString('base64'))"
AUTH_ENCRYPTION_KEY=REPLACE_WITH_BASE64_32_BYTE_KEY
# Absolute session lifetime in seconds (default 30 days) and idle timeout (default 7 days).
# The idle timeout must not exceed the absolute lifetime.
AUTH_SESSION_ABSOLUTE_TTL_SECONDS=2592000
AUTH_SESSION_IDLE_TTL_SECONDS=604800
# Durable per-account lockout after consecutive failed sign-ins.
AUTH_MAX_FAILED_ATTEMPTS=10
AUTH_LOCKOUT_SECONDS=900
# Lifetime of a single-use password reset token.
AUTH_PASSWORD_RESET_TTL_SECONDS=1800
# Label shown in the authenticator application for administrator MFA.
AUTH_MFA_ISSUER=Nordhaven Commerce
# Notification transport for recovery material: none | file | memory.
# Production must stay "none" until a delivery provider is approved (HC-DEC-014). "file" writes to
# an ignored tmp/notifications directory for local development only; "memory" is for automated tests.
AUTH_NOTIFICATION_TRANSPORT=none

# Customer notification channel (Milestone 12): none | file | memory.
# Production must stay "none" until a delivery provider is approved (HC-DEC-014). "file" writes to an
# ignored tmp/notifications directory for local development only and refuses to start in production;
# "memory" is for automated tests. With "none" the platform records what it would have sent and
# delivers nothing.
CUSTOMER_NOTIFICATION_TRANSPORT=none

# Initial pending-payment hold; default 15 minutes, accepted range 60..86400 seconds.
ORDER_RESERVATION_TTL_SECONDS=900
