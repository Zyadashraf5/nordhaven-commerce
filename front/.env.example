# ---------------------------------------------------------------------------
# Nordhaven Commerce — storefront frontend
#
# Copy to `.env.local` and adjust. Every value is optional in Milestone 1:
# the homepage renders the approved Stage 1 design with clearly identified
# sample data and never claims that a value comes from the backend.
# ---------------------------------------------------------------------------

# Public base URL of the audited NestJS API.
# Example: http://localhost:3000
# Leave empty until the catalog endpoints are connected (see src/lib/api/).
NEXT_PUBLIC_API_BASE_URL=

# Server-only override, for deployments where the API is only reachable
# from the server and not from the browser.
API_BASE_URL=
