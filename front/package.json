{
  "name": "@nordhaven/front",
  "version": "0.1.0",
  "private": true,
  "description": "Nordhaven portfolio storefront built with Next.js and React.",
  "engines": {
    "node": ">=22.23.3 <23"
  },
  "scripts": {
    "dev": "next dev --port 3001",
    "build": "next build",
    "start": "next start --port 3001",
    "lint": "eslint . --max-warnings 0",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@gsap/react": "2.1.2",
    "gsap": "3.15.0",
    "lenis": "1.3.26",
    "next": "15.5.28",
    "react": "19.2.9",
    "react-dom": "19.2.9"
  },
  "devDependencies": {
    "@eslint/js": "9.39.1",
    "@next/eslint-plugin-next": "15.5.28",
    "@testing-library/dom": "10.4.2",
    "@testing-library/jest-dom": "6.6.3",
    "@testing-library/react": "16.3.3",
    "@types/node": "22.19.1",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.7",
    "eslint": "9.39.1",
    "eslint-config-next": "15.5.28",
    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-react-hooks": "5.2.0",
    "globals": "16.5.0",
    "jsdom": "26.1.0",
    "prettier": "3.7.4",
    "typescript": "5.9.3",
    "typescript-eslint": "8.51.0",
    "vitest": "4.1.12"
  }
}
